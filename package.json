{
  "name": "poker-probability-calculator",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "A mathematically rigorous local poker probability calculator (Texas Hold'em & Omaha Hi).",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/engine/cli.ts",
    "replay": "tsx src/pokernow/replay.ts",
    "build:ext": "vite build -c vite.config.extension.ts && vite build -c vite.config.content.ts && cp extension/manifest.json extension/dist/manifest.json",
    "accuracy": "tsx tools/range-accuracy.ts",
    "profile": "tsx tools/play-profile.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.2.7",
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }
}
